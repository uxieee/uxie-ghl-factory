       "disabled": false,
       "showBelowCustomField": false,
       "dynamicFieldsConfig": {
        "route": "",
        "serviceName": "",
        "customGenerator": "/**\n * This is wrapped in an async function\n * You can use await throughout the function\n */\nasync (staticInputs, attributes, extras) => {\n  if (attributes.contactField) {\n    staticInputs['skipIfFilled'].disabled = false\n  } else {\n    staticInputs['skipIfFilled'].disabled = true\n    staticInputs['skipIfFilled'].value = false\n    attributes.skipIfFilled = false\n  }\n  if (attributes.proceedIfNotMet) {\n    return {\n      inputs: [{\n        field: \"closingMessage\",\n        title: \"Closing Message\",\n        fieldType: \"string\",\n        required: true,\n      }, {\n        field: \"tags\",\n        title: \"Add a Tag\",\n        fieldType: \"multiselect\",\n        mappedTo: 'TAGS',\n      }]\n    }\n  }\n}",
        "url": "",
        "method": "GET",
