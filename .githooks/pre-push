#!/bin/sh
# Push is when the docs become public, so it is where the claims get checked against the
# live server. Not pre-commit: this starts the published MCP server over npx, which needs
# the network and takes ~40s — too slow to pay on every commit.
#
# The check SKIPS (exit 0) when the package cannot be reached, so being offline does not
# block a push.
set -e
node scripts/check-mcp-contract.mjs
node scripts/check-type-catalog.mjs
# Every generated artefact (type-cards, source, catalogue, manifests, dist) must match a
# regeneration — a release cut from stale copies is the failure this repo keeps re-learning.
node scripts/check-generated-freshness.mjs
# Every `example:` pointer in the shipped catalogue must resolve from where the catalogue ships.
# The script has existed since the type-catalogue work and was wired into nothing, so a broken
# pointer could reach a release unread.
node scripts/check-example-pointers.mjs
